# Copy to .env (gitignored) and fill in. The library reads only these
# environment variables; see DESIGN-SENATE.md §8 for where each runtime
# stores them. Leave the R2_* variables unset to use the local-directory
# storage backend.

# Cloudflare R2 (S3-compatible). Token scoped to object read+write on one bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ENDPOINT=   # https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=

# Local storage backend root (used when R2_* are unset). Default: ./data
STORAGE_LOCAL_ROOT=

# Google AI Studio key; serves Gemma 4 (free tier) and Gemini Flash.
GEMINI_API_KEY=

# Self-hosted Gemma on Colab, overflow path only; set per Colab session.
COLAB_BASE_URL=

# Contact address sent in the User-Agent / From headers to the Clerk and eFD.
CONTACT_EMAIL=
